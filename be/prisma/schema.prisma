// Built from docs/ERD_edited.md
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              BigInt    @id @default(autoincrement())
  email           String    @unique @db.VarChar(255)
  username        String    @unique @db.VarChar(50)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  role            String    @default("customer") @db.VarChar(20)
  status          String    @default("active") @db.VarChar(20)
  creditBalance   Decimal   @default(0) @map("credit_balance") @db.Decimal(14, 2)
  heldBalance     Decimal   @default(0) @map("held_balance") @db.Decimal(14, 2)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  info               UserInfo?
  goods              Goods[]                  @relation("SellerGoods")
  boughtGoods        Goods[]                  @relation("BuyerGoods")
  reviewedGoods      Goods[]                  @relation("ReviewedGoods")
  auctions           Auction[]                @relation("SellerAuctions")
  wonAuctions        Auction[]                @relation("WinnerAuctions")
  bids               BidTicket[]
  transactions       CreditTransaction[]
  reviewedCredit     CreditTransaction[]      @relation("ReviewedCredit")
  messages           AuctionMessage[]
  resetTokens        PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  refreshTokens      RefreshToken[]
  knowledgeDocuments KnowledgeDocument[]
  chatConversations  ChatConversation[]       @relation("CustomerChats")
  assignedChats      ChatConversation[]       @relation("StaffChats")
  chatMessages       ChatMessage[]
  ragSessions        RagSession[]
  ragReviews         RagExample[]

  @@map("users")
}

model UserInfo {
  userId    BigInt   @id @map("user_id")
  fullName  String?  @map("full_name") @db.VarChar(255)
  phone     String?  @db.VarChar(30)
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_info")
}

model Category {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?
  status      String   @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  goods       Goods[]

  @@map("categories")
}

model Goods {
  id              BigInt       @id @default(autoincrement())
  sellerId        BigInt       @map("seller_id")
  /// gds-003: winner of the goods' last sale; the current owner is buyer when set, otherwise seller.
  buyerId         BigInt?      @map("buyer_id")
  categoryId      BigInt?      @map("category_id")
  name            String       @db.VarChar(255)
  description     String?
  condition       String?      @db.VarChar(30)
  /// stf-005: pending (waiting for staff) | active (approved) | rejected | deleted
  status          String       @default("active") @db.VarChar(20)
  rejectionReason String?      @map("rejection_reason")
  reviewedAt      DateTime?    @map("reviewed_at")
  reviewedById    BigInt?      @map("reviewed_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  seller          User         @relation("SellerGoods", fields: [sellerId], references: [id])
  reviewedBy      User?        @relation("ReviewedGoods", fields: [reviewedById], references: [id])
  buyer           User?        @relation("BuyerGoods", fields: [buyerId], references: [id])
  category        Category?    @relation(fields: [categoryId], references: [id])
  images          GoodsImage[]
  auctions        Auction[]

  @@index([status])
  @@map("goods")
}

model GoodsImage {
  id        BigInt   @id @default(autoincrement())
  goodsId   BigInt   @map("goods_id")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  goods     Goods    @relation(fields: [goodsId], references: [id], onDelete: Cascade)

  @@map("goods_images")
}

model Auction {
  id              BigInt    @id @default(autoincrement())
  sellerId        BigInt    @map("seller_id")
  goodsId         BigInt    @map("goods_id")
  winnerId        BigInt?   @map("winner_id")
  name            String    @db.VarChar(255)
  description     String?
  initialPrice    Decimal   @map("initial_price") @db.Decimal(14, 2)
  reservePrice    Decimal?  @map("reserve_price") @db.Decimal(14, 2)
  currentPrice    Decimal?  @map("current_price") @db.Decimal(14, 2)
  durationMinutes Int       @map("duration_minutes")
  startTime       DateTime  @map("start_time")
  endTime         DateTime  @map("end_time")
  status          String    @default("upcoming") @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  cancelledAt     DateTime? @map("cancelled_at")
  closedAt        DateTime? @map("closed_at")
  /// stf-006: soft delete by staff; hidden from every customer page
  deletedAt       DateTime? @map("deleted_at")

  seller       User                @relation("SellerAuctions", fields: [sellerId], references: [id])
  winner       User?               @relation("WinnerAuctions", fields: [winnerId], references: [id])
  goods        Goods               @relation(fields: [goodsId], references: [id])
  bids         BidTicket[]
  transactions CreditTransaction[]
  settlement   AuctionSettlement?
  messages     AuctionMessage[]

  @@index([status, endTime])
  @@map("auctions")
}

model BidTicket {
  id           BigInt              @id @default(autoincrement())
  auctionId    BigInt              @map("auction_id")
  bidderId     BigInt              @map("bidder_id")
  amount       Decimal             @db.Decimal(14, 2)
  status       String              @default("active") @db.VarChar(20)
  createdAt    DateTime            @default(now()) @map("created_at")
  wonAt        DateTime?           @map("won_at")
  auction      Auction             @relation(fields: [auctionId], references: [id])
  bidder       User                @relation(fields: [bidderId], references: [id])
  transactions CreditTransaction[]
  settlement   AuctionSettlement?

  @@index([auctionId, amount])
  @@map("bid_tickets")
}

model CreditTransaction {
  id              BigInt     @id @default(autoincrement())
  userId          BigInt     @map("user_id")
  auctionId       BigInt?    @map("auction_id")
  bidTicketId     BigInt?    @map("bid_ticket_id")
  transactionType String     @map("transaction_type") @db.VarChar(20)
  amount          Decimal    @db.Decimal(14, 2)
  balanceBefore   Decimal    @map("balance_before") @db.Decimal(14, 2)
  balanceAfter    Decimal    @map("balance_after") @db.Decimal(14, 2)
  description     String?
  /// stf-007: pending (request waiting for staff) | posted (applied) | rejected | deleted (stf-008)
  status          String     @default("posted") @db.VarChar(20)
  rejectionReason String?    @map("rejection_reason")
  reviewedAt      DateTime?  @map("reviewed_at")
  reviewedById    BigInt?    @map("reviewed_by")
  createdAt       DateTime   @default(now()) @map("created_at")
  user            User       @relation(fields: [userId], references: [id])
  auction         Auction?   @relation(fields: [auctionId], references: [id])
  bidTicket       BidTicket? @relation(fields: [bidTicketId], references: [id])
  reviewedBy      User?      @relation("ReviewedCredit", fields: [reviewedById], references: [id])

  @@index([status])
  @@map("credit_transactions")
}

model AuctionSettlement {
  id               BigInt     @id @default(autoincrement())
  auctionId        BigInt     @unique @map("auction_id")
  winningBidId     BigInt?    @unique @map("winning_bid_id")
  commissionAmount Decimal    @default(0) @map("commission_amount") @db.Decimal(14, 2)
  settlementStatus String     @default("pending") @map("settlement_status") @db.VarChar(20)
  settledAt        DateTime?  @map("settled_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  auction          Auction    @relation(fields: [auctionId], references: [id])
  winningBid       BidTicket? @relation(fields: [winningBidId], references: [id])

  @@map("auction_settlements")
}

model BidIncrementRule {
  id              BigInt   @id @default(autoincrement())
  minBidAmount    Decimal  @map("min_bid_amount") @db.Decimal(14, 2)
  maxBidAmount    Decimal? @map("max_bid_amount") @db.Decimal(14, 2)
  incrementAmount Decimal  @map("increment_amount") @db.Decimal(14, 2)
  status          String   @default("active") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("bid_increment_rules")
}

model AuctionMessage {
  id        BigInt   @id @default(autoincrement())
  auctionId BigInt   @map("auction_id")
  authorId  BigInt   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  auction   Auction  @relation(fields: [auctionId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])

  @@map("auction_messages")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  /// mail-003: reset (forgot password) | change (signed-in user asked for a change link)
  purpose   String    @default("reset") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

/// sec-003: one row per issued refresh token (only its SHA-256 hash). Rows are revoked, never deleted.
model RefreshToken {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  /// rotated | reuse | logout | idle | password | locked | deleted
  revokeReason String?   @map("revoke_reason") @db.VarChar(20)
  replacedById BigInt?   @map("replaced_by_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

// sec-002: role-based permissions. Roles are the values of users.role.
model Permission {
  id          BigInt           @id @default(autoincrement())
  code        String           @unique @db.VarChar(50)
  description String           @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         String     @db.VarChar(20)
  permissionId BigInt     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@map("role_permissions")
}

// rag-1.1: documents uploaded for the chat box (be/chat.py) and their embedded chunks. Delete = soft delete.
model KnowledgeDocument {
  id           BigInt           @id @default(autoincrement())
  title        String           @db.VarChar(255)
  filename     String           @db.VarChar(255)
  mimeType     String           @map("mime_type") @db.VarChar(100)
  content      String
  sizeBytes    Int              @map("size_bytes")
  uploadedById BigInt           @map("uploaded_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  deletedAt    DateTime?        @map("deleted_at")
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  chunks       KnowledgeChunk[]

  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id            BigInt            @id @default(autoincrement())
  documentId    BigInt            @map("document_id")
  position      Int
  text          String
  embedding     Float[]
  createdAt     DateTime          @default(now()) @map("created_at")
  document      KnowledgeDocument @relation(fields: [documentId], references: [id])
  ragRetrievals RagRetrieval[]

  @@unique([documentId, position])
  @@index([documentId])
  @@map("knowledge_chunks")
}

// sch-1.4: conversations the chat bot handed to staff (sch-1.3) and their messages. Delete = soft delete.
model ChatConversation {
  id              BigInt        @id @default(autoincrement())
  customerId      BigInt        @map("customer_id")
  /// waiting | assigned | closed
  status          String        @default("waiting") @db.VarChar(20)
  /// limit | unavailable (sch-1.3)
  handoffReason   String        @map("handoff_reason") @db.VarChar(20)
  assignedStaffId BigInt?       @map("assigned_staff_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  assignedAt      DateTime?     @map("assigned_at")
  closedAt        DateTime?     @map("closed_at")
  deletedAt       DateTime?     @map("deleted_at")
  customer        User          @relation("CustomerChats", fields: [customerId], references: [id])
  assignedStaff   User?         @relation("StaffChats", fields: [assignedStaffId], references: [id])
  messages        ChatMessage[]

  @@index([status, createdAt])
  @@index([customerId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             BigInt           @id @default(autoincrement())
  conversationId BigInt           @map("conversation_id")
  /// customer | bot | staff
  sender         String           @db.VarChar(20)
  /// null for bot messages
  senderId       BigInt?          @map("sender_id")
  text           String           @db.VarChar(1000)
  createdAt      DateTime         @default(now()) @map("created_at")
  deletedAt      DateTime?        @map("deleted_at")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
  senderUser     User?            @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// rag-train-1: the RAG bot's conversations, kept to review and export as training data. Delete = soft delete.
model RagSession {
  id          BigInt    @id @default(autoincrement())
  /// null = guest
  userId      BigInt?   @map("user_id")
  /// sha256 of the visitor token, never the raw token
  visitorHash String    @map("visitor_hash") @db.VarChar(64)
  locale      String?   @db.VarChar(10)
  startedAt   DateTime  @default(now()) @map("started_at")
  deletedAt   DateTime? @map("deleted_at")
  user        User?     @relation(fields: [userId], references: [id])
  turns       RagTurn[]

  @@index([userId])
  @@index([startedAt])
  @@map("rag_sessions")
}

model RagTurn {
  id               BigInt         @id @default(autoincrement())
  sessionId        BigInt         @map("session_id")
  turnIndex        Int            @map("turn_index")
  userText         String         @map("user_text")
  botText          String?        @map("bot_text")
  /// answered | refused | handed_off | error
  outcome          String         @db.VarChar(20)
  /// null when no guard fired; e.g. prompt_injection | secrets | prompt_leak
  guardTriggered   String?        @map("guard_triggered") @db.VarChar(40)
  /// up | down, from the visitor's thumbs
  feedback         String?        @db.VarChar(10)
  model            String         @db.VarChar(60)
  /// hash of the system prompt, so each answer is tied to the prompt that produced it
  promptVersion    String         @map("prompt_version") @db.VarChar(64)
  promptTokens     Int?           @map("prompt_tokens")
  completionTokens Int?           @map("completion_tokens")
  latencyMs        Int?           @map("latency_ms")
  createdAt        DateTime       @default(now()) @map("created_at")
  deletedAt        DateTime?      @map("deleted_at")
  session          RagSession     @relation(fields: [sessionId], references: [id])
  retrievals       RagRetrieval[]
  example          RagExample?

  @@unique([sessionId, turnIndex])
  @@index([createdAt])
  @@map("rag_turns")
}

/// Chunks the retriever returned for a turn, and whether the bot cited them.
model RagRetrieval {
  id      BigInt         @id @default(autoincrement())
  turnId  BigInt         @map("turn_id")
  chunkId BigInt         @map("chunk_id")
  rank    Int
  score   Float
  cited   Boolean        @default(false)
  turn    RagTurn        @relation(fields: [turnId], references: [id])
  chunk   KnowledgeChunk @relation(fields: [chunkId], references: [id])

  @@unique([turnId, chunkId])
  @@map("rag_retrievals")
}

/// A reviewed turn, ready to export as training data.
model RagExample {
  id         BigInt    @id @default(autoincrement())
  turnId     BigInt    @unique @map("turn_id")
  /// raw | approved | rejected | exported
  status     String    @default("raw") @db.VarChar(20)
  /// good | bad | needs_fix
  label      String?   @db.VarChar(20)
  /// the reviewer's better answer, when the bot's needed fixing
  idealReply String?   @map("ideal_reply")
  reviewerId BigInt?   @map("reviewer_id")
  reviewedAt DateTime? @map("reviewed_at")
  exportedAt DateTime? @map("exported_at")
  turn       RagTurn   @relation(fields: [turnId], references: [id])
  reviewer   User?     @relation(fields: [reviewerId], references: [id])

  @@index([status])
  @@map("rag_examples")
}
