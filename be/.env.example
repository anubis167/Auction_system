DATABASE_URL=postgresql://auction:auction@localhost:5436/auction
JWT_SECRET=change-me
PORT=4000
APP_URL=http://localhost:5173

# mail-001: Gmail through Nodemailer with OAuth 2.0 (see docs/mail.md). Leave empty to use the dev outbox.
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM_NAME="Beat'em"

# rag2-1.1: shared secret between the Python chat service (be/rag) and the Node /api/rag routes (docs/rag.md).
# Both read this same file. Empty = the service-only routes answer 503 (no document excerpts, no uploads).
RAG_INTERNAL_TOKEN=
# Where be/rag finds the Node API (default http://localhost:4000)
RAG_API_URL=http://localhost:4000
# rag-train-8: chat bot turns nobody reviewed are soft-deleted after this many days (default 180)
RAG_TURN_RETENTION_DAYS=180
