{
  "name": "auction-system",
  "private": true,
  "workspaces": [
    "be",
    "fe"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait db redis",
    "db:migrate": "npm run db:migrate -w be",
    "test": "npm run db:up && npm test -w be && npm test -w fe && npm run build -w fe && npm run test:py",
    "test:py": "cross-env GEMINI_API_KEY=test-key NGROK_AUTHTOKEN=test-token RAG_INTERNAL_TOKEN=test-internal-token python -m unittest discover -s e2e/py -t e2e/py -p \"*_test.py\"",
    "e2e": "npm run db:up && playwright test",
    "dev": "npm run db:up && concurrently -n be,fe -c blue,green \"npm run dev -w be\" \"npm run dev -w fe\"",
    "postinstall": "npx prisma generate --schema be/prisma/schema.prisma",
    "verify": "npm test && npm run e2e"
  },
  "prisma": {
    "seed": "tsx be/prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "9.1.0",
    "dotenv-cli": "^11.1.0"
  },
  "overrides": {
    "is-generator-function": "1.0.10",
    "is-async-function": "2.0.0",
    "tmp": "0.2.7",
    "exceljs": {
      "fast-csv": "^4.3.6",
      "tmp": "0.2.7"
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "axios": "1.21.1",
    "express": "4.22.3",
    "multer": "2.5.0",
    "nodemailer": "10.6.1",
    "react-router-dom": "^7.18.6",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "vitest": "^4.1.12",
    "zod": "4.6.7"
  }
}
